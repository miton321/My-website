# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ADMIN_USERNAME & ADMIN_PASSWORD: Required to seed and access the private admin panel.
# Set these in your hosting dashboard or local .env (never commit real credentials).
ADMIN_USERNAME="change_me_admin_user"
ADMIN_PASSWORD="change_me_strong_password"

# SESSION_SECRET: 64-char random hex string used to sign httpOnly session cookies.
SESSION_SECRET="replace_with_a_long_random_hex_secret"

# DATABASE_URL: Optional PostgreSQL / Supabase connection string for cloud deployments.
# When omitted, the server uses a local parameterized SQLite database in ./data/portfolio.db.
DATABASE_URL="postgresql://user:password@host:5432/portfolio?sslmode=require"

# EMAIL_SERVICE_API_KEY: Optional transactional email provider key (e.g., Resend) for contact notifications.
EMAIL_SERVICE_API_KEY="replace_with_email_service_key"

# STORAGE_KEY: Optional object storage access key (e.g., S3 / R2 / Supabase Storage) for production uploads.
STORAGE_KEY="replace_with_storage_access_key"
